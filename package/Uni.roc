## Unicode Tier A (M2). GENERATED from regex-syntax 0.8 — do not hand-edit.
## Ranges are packed as 6-hex-digit codepoint pairs in a Str literal; the
## decoder folds them to List({ lo, hi }) at compile time (D4).
Uni := [].{
    Rng : { lo : U32, hi : U32 }

    w_hex : Str
    w_hex = ""
    d_hex : Str
    d_hex = ""
    s_hex : Str
    s_hex = "00000900000d0000200000200000850000850000a00000a000168000168000200000200a00202800202900202f00202f00205f00205f003000003000"
    gc_l : Str
    gc_l = ""
    gc_lu : Str
    gc_lu = ""
    gc_ll : Str
    gc_ll = ""
    gc_n : Str
    gc_n = ""
    gc_nd : Str
    gc_nd = ""
    gc_p : Str
    gc_p = ""
    gc_sm : Str
    gc_sm = ""
    gc_zs : Str
    gc_zs = "0000200000200000a00000a000168000168000200000200a00202f00202f00205f00205f003000003000"
    scr_greek : Str
    scr_greek = ""
    scr_latin : Str
    scr_latin = ""
    scr_cyrillic : Str
    scr_cyrillic = "00040000048400048700052f001c80001c8a001d2b001d2b001d78001d78002de0002dff00a64000a69f00fe2e00fe2f01e03001e06d01e08f01e08f"
    scr_han : Str
    scr_han = "002e80002e99002e9b002ef3002f00002fd500300500300500300700300700302100302900303800303b003400004dbf004e00009fff00f90000fa6d00fa7000fad9016fe2016fe3016ff0016ff102000002a6df02a70002b73902b74002b81d02b82002cea102ceb002ebe002ebf002ee5d02f80002fa1d03000003134a0313500323af"
    fold_hex : Str
    fold_hex = ""

    ## packed ranges for a property name, or Err if not in Tier A / not found.
    lookup : Str -> Try(Str, [NotFound])
    lookup = |name|
        match name {
            "L" => Ok(Uni.gc_l)
            "Letter" => Ok(Uni.gc_l)
            "Lu" => Ok(Uni.gc_lu)
            "Ll" => Ok(Uni.gc_ll)
            "N" => Ok(Uni.gc_n)
            "Number" => Ok(Uni.gc_n)
            "Nd" => Ok(Uni.gc_nd)
            "P" => Ok(Uni.gc_p)
            "Punctuation" => Ok(Uni.gc_p)
            "Sm" => Ok(Uni.gc_sm)
            "Zs" => Ok(Uni.gc_zs)
            "Greek" => Ok(Uni.scr_greek)
            "Latin" => Ok(Uni.scr_latin)
            "Cyrillic" => Ok(Uni.scr_cyrillic)
            "Han" => Ok(Uni.scr_han)
            _ => Err(NotFound)
        }

    ## decode a packed hex string to ranges (folds at compile time when the input
    ## is a literal).
    ranges : Str -> List(Uni.Rng)
    ranges = |hex| Uni.decode(Str.to_utf8(hex), 0, [])

    decode : List(U8), U64, List(Uni.Rng) -> List(Uni.Rng)
    decode = |b, i, acc|
        if i + 12 > List.len(b) {
            acc
        } else {
            lo = Uni.hex6(b, i)
            hi = Uni.hex6(b, i + 6)
            Uni.decode(b, i + 12, List.append(acc, { lo, hi }))
        }

    hex6 : List(U8), U64 -> U32
    hex6 = |b, i|
        Uni.hd(b, i).shl_wrap(20)
        |> U32.bitwise_or(Uni.hd(b, i + 1).shl_wrap(16))
        |> U32.bitwise_or(Uni.hd(b, i + 2).shl_wrap(12))
        |> U32.bitwise_or(Uni.hd(b, i + 3).shl_wrap(8))
        |> U32.bitwise_or(Uni.hd(b, i + 4).shl_wrap(4))
        |> U32.bitwise_or(Uni.hd(b, i + 5))

    hd : List(U8), U64 -> U32
    hd = |b, i| {
        c = List.get(b, i) ?? 48
        if c >= 97 { (c - 87).to_u32() } else { (c - 48).to_u32() }
    }

    ## fold partners of a codepoint (M2 (?i)): the other members of its orbit.
    fold_of : U32 -> List(U32)
    fold_of = |cp| {
        rs = Uni.ranges(Uni.fold_hex)
        List.keep_if(rs, |r| r.lo == cp) |> List.map(|r| r.hi)
    }

}
