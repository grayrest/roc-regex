# roc__proc_4b2a — `spush` in package/Pike.roc, from a --opt=speed --debug build
# of the regex benchmark (arm64 macOS, release-fast-b9fea521). This is the hot
# PikeVM helper; the same code is what `spush` in repro.roc lowers to.
#
#   spush = |stack, i, v|
#       if i < List.len(stack) { List.set(stack, i, v) ?? stack }
#       else { List.append(stack, v) }
#
# The whole function does ONE useful thing (a store); everything else is a guard.

roc__proc_4b2a:
 +0:   sub  sp, sp, #0x80                 ; 128-byte frame ...
 +4:   stp  x28, x27, [sp, #0x20]         ; ... to save 12 callee-saved regs,
 +8:   stp  x26, x25, [sp, #0x30]         ;     needed only by the cold clone path
 +12:  stp  x24, x23, [sp, #0x40]
 +16:  stp  x22, x21, [sp, #0x50]
 +20:  stp  x20, x19, [sp, #0x60]
 +24:  stp  x29, x30, [sp, #0x70]
 +28:  ldp  x20, x19, [x1]                ; load stack: ptr, len
 +32:  ldp  x21, x25, [x1, #0x10]         ;   cap|slice-tag, and arg i
 +36:  ldr  w24, [x1, #0x20]              ;   arg v
 +40:  and  x8, x21, #0x1                 ; \  seamless-slice discriminant bit
 +44:  lsr  x9, x21, #1                   ; /  (lists may be slices)
 +48:  cmp  x25, x19                      ; i < len ?
 +52:  b.hs 0x...154                      ;   no -> append path
 +56:  cmp  x8, #0x0                      ; \
 +60:  csel x9, x9, x19, eq               ;  |  slice-bit resolution
 +64:  orr  x9, x9, x8                    ;  |
 +68:  cbz  x9, 0x...144                  ; /
 +72:  and  x9, x21, #0xfffffffffffffffe  ; \
 +76:  cmp  x8, #0x0                      ;  |  UNIQUENESS CHECK:
 +80:  csel x23, x20, x9, eq              ;  |  load refcount, compare to 1,
 +84:  ldr  x8, [x23, #-0x8]!             ;  |  branch to clone if not unique
 +88:  cmp  x8, #0x1                      ;  |
 +92:  b.ne 0x...188                      ; /   -> clone path (+164)
 +96:  mov  x26, x21
 +100: mov  x22, x20
 +104: str  w24, [x20, x25, lsl #2]       ; <=== THE STORE (in place). 1 instruction.
 +108: b    0x...1fc                      ; -> epilogue (restore 12 regs)
 ...   +112..+160  append-in-place path
 +164: ...                                ; CLONE path: roc_alloc / memcpy the
 +192: bl   roc_alloc                     ;   whole 2000-elem list / decref old —
 +224: bl   memcpy                        ;   dead here (buffer is always unique)
 +268: bl   roc_dealloc
